  m_Name: 
  m_EditorClassIdentifier: 
  tutorialText: {fileID: 745923706}
  tutorialImage: {fileID: 1753544626}
  tutorialSteps:
  - text: Bienvenido a Filius Umbrae!
    image: {fileID: 0}
  - text: En este juego tu mision es proteger el castillo
    image: {fileID: 0}
  - text: Los controles son los siguientes
    image: {fileID: 0}
  - text: Tienes habilidades y puedes colocar torres
    image: {fileID: 21300000, guid: 84f789d272e4adf42a655795abfb72bf, type: 3}
  - text: "Habr\xE1 espacios que brillen y ah\xED las colocas"
    image: {fileID: 0}
  - text: Cada una cuesta dinero y tienes mana para los poderes
    image: {fileID: 0}
  - text: Tambien puedes atacar cuerpo a cuerpo
    image: {fileID: 0}
  - text: Suerte!
    image: {fileID: 0}
  isTutorialComplete: 0
